#!/bin/sh
# Runs the update check (luci-app-fwupdate) a minute after boot and then every
# fwupdate.settings.interval hours. Without a connection it tries three times a minute
# apart, then once an hour until a check gets through. It only reads from the network and
# writes to /tmp, so a missing connection costs nothing.

interval=$(uci -q get fwupdate.settings.interval)
case "$interval" in
''|*[!0-9]*|0) interval=24 ;;
esac

pause() {
	sleep "$1" &
	PAUSE=$!
	wait $PAUSE
}

trap 'kill $PAUSE 2>/dev/null; exit 0' TERM INT

pause 60
while :; do
	tries=0
	while :; do
		/usr/libexec/fwupdate check
		[ $? -eq 2 ] || break
		tries=$((tries + 1))
		if [ $tries -lt 3 ]; then
			pause 60
		else
			tries=0
			pause 3600
		fi
	done
	pause $((interval * 3600))
done
