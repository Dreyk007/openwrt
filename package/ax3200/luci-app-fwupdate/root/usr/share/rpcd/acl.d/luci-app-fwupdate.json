{
	"luci-app-fwupdate": {
		"description": "Grant access to the firmware update check",
		"read": {
			"ubus": {
				"luci.fwupdate": [ "status" ]
			},
			"uci": [ "fwupdate" ]
		},
		"write": {
			"ubus": {
				"luci.fwupdate": [ "check", "download", "discard", "upgrade", "skip", "asu_off" ]
			},
			"uci": [ "fwupdate" ]
		}
	}
}
