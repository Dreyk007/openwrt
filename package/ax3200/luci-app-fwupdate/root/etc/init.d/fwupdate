#!/bin/sh /etc/rc.common
# Firmware update check of the Xiaomi AX3200 / Redmi AX6S build (luci-app-fwupdate): looks
# for a new GitHub release after boot and then at the interval set in /etc/config/fwupdate.
# After an update with "Keep my packages" it also installs the user's packages again.

START=99
USE_PROCD=1

start_service() {
	local enabled

	config_load fwupdate
	config_get_bool enabled settings enabled 1
	if [ "$enabled" = 1 ]; then
		procd_open_instance check
		procd_set_param command /usr/libexec/fwupdate-daemon
		procd_set_param respawn 3600 60 0
		procd_close_instance
	fi

	# whether update checks are on or off
	if /usr/libexec/fwupdate-packages pending; then
		procd_open_instance packages
		procd_set_param command /usr/libexec/fwupdate-packages restore
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger fwupdate
}
