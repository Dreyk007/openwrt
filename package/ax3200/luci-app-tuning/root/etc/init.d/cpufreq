#!/bin/sh /etc/rc.common
# Apply the CPU frequency governor and the schedutil rate limit from /etc/config/cpufreq
# (LuCI: System -> Operating mode, or "tuning")

START=15
USE_PROCD=1

start_service() {
	local governor policy rate_limit

	config_load cpufreq
	config_get governor settings governor
	# the kernel's 1 ms lets sugov:0 take 7-15 % of a core during transfers (RESEARCH.md section 5)
	config_get rate_limit settings rate_limit_us 10000
	[ -n "$governor" ] || return 0

	for policy in /sys/devices/system/cpu/cpufreq/policy*; do
		[ -d "$policy" ] || continue
		if ! grep -qw "$governor" "$policy/scaling_available_governors"; then
			logger -t cpufreq "governor '$governor' is not available for ${policy##*/}"
			continue
		fi
		echo "$governor" > "$policy/scaling_governor"
		# schedutil starts with the kernel's default whenever it is selected again
		if [ "$governor" = schedutil ] && [ -w "$policy/schedutil/rate_limit_us" ]; then
			echo "$rate_limit" > "$policy/schedutil/rate_limit_us"
		fi
	done
}

service_triggers() {
	procd_add_reload_trigger cpufreq
}
