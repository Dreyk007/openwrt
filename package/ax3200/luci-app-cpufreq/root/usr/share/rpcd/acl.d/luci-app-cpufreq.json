{
	"luci-app-cpufreq": {
		"description": "Grant access to the CPU frequency governor settings",
		"read": {
			"file": {
				"/sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors": [ "read" ],
				"/sys/devices/system/cpu/cpufreq/policy0/scaling_governor": [ "read" ],
				"/sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq": [ "read" ],
				"/sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq": [ "read" ],
				"/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq": [ "read" ]
			},
			"uci": [ "cpufreq" ]
		},
		"write": {
			"uci": [ "cpufreq" ]
		}
	}
}
