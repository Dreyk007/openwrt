. /lib/functions.sh
. /lib/functions/system.sh

radio_en=%ENABLE%
[ "$radio_en" != "y" ] && exit 0

[ -x /sbin/wifi ] && /sbin/wifi config
[ ! -e /etc/config/wireless ] && exit 0

radio_enable() {
	local num=$1
	local ssid='%SSID%'
	local encryption=%ENCRYPTION%
	local key='%KEY%'
	local country='%COUNTRY%'
	local band="$( uci -q get wireless.radio$num.band )"
	uci set wireless.radio$num.disabled=0
	uci set wireless.radio$num.cell_density='0'
	if [ -n "$country" ]; then
		uci set wireless.radio$num.country=$country
	fi
	if [ "$band" = "2g" ]; then
		uci set wireless.radio$num.channel='1'
		uci set wireless.radio$num.htmode='HT20'
	elif [ "$band" = "5g" ]; then
		uci set wireless.radio$num.channel='36'
		uci set wireless.radio$num.htmode='HE80'
		uci set wireless.radio$num.noscan='1'
	fi
	if [ -z "$ssid" ]; then
		ssid="$( board_name | cut -d ',' -f2- )"
	fi
	ssid="$ssid-$band"
	ssid="$ssid-$num"
	ssid="$ssid$( get_mac_label | sed -r 's/://g' | tail -c 5 )"
	if [ "${#ssid}" -gt 28 ]; then
		ssid="${ssid//-ubootmod/}"
		ssid="${ssid//ubootmod/}"
	fi
	if [ "${#ssid}" -gt 28 ]; then
		ssid="${ssid//-stock/}"
		ssid="${ssid//stock/}"
	fi
	if [ "${#ssid}" -gt 28 ]; then
		ssid="${ssid//-router/}"
		ssid="${ssid//router/}"
	fi
	if [ "${#ssid}" -gt 28 ]; then
		ssid="$( echo -n "$ssid" | tail -c 28 )"
	fi
	ssid="$( echo -n "$ssid" | sed -r 's/[\.\,:]+/-/g' )"
	uci set wireless.default_radio$num.disabled=0
	uci set wireless.default_radio$num.ssid="$ssid"
	if [ "$band" = "5g" ]; then
		uci set wireless.default_radio$num.wnm_sleep_mode='1'
		uci set wireless.default_radio$num.wnm_sleep_mode_no_keys='1'
		uci set wireless.default_radio$num.dtim_period='3'
		uci set wireless.default_radio$num.ocv='0'
	fi
	if [ -n "$key" ]; then
		[ -z "$encryption" ] && encryption=psk2+ccmp
		# 5 GHz: WPA2/WPA3 mixed mode (SAE + PSK) instead of plain psk2+ccmp
		[ "$band" = "5g" ] && [ "$encryption" = "psk2+ccmp" ] && encryption=sae-mixed
		uci set wireless.default_radio$num.encryption=$encryption
		uci set wireless.default_radio$num.key="$key"
	fi
}

for num in 0 1; do 
	if [ "$( uci -q get wireless.radio$num.type )" != "" ]; then
		if [ "$( uci -q get wireless.default_radio$num.key )" == "" ]; then
			radio_enable $num
		fi
	fi
done
uci -q commit wireless

exit 0
