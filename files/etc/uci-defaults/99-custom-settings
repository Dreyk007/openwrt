#!/bin/sh
#
# Default settings of the Xiaomi AX3200 / Redmi AX6S build.
#
# uci-defaults scripts run on the first boot after every flash, including a
# sysupgrade that keeps settings. These defaults are applied only once per
# configuration: a marker is stored in /etc/config/ax3200, which sysupgrade
# keeps together with the rest of /etc/config. This way user changes, e.g.
# disabling flow offloading in favour of SQM, survive firmware upgrades.
#
# Wi-Fi radio defaults are set by /etc/uci-defaults/77_wireless.

[ "$(uci -q get ax3200.defaults.applied)" = "1" ] && exit 0

# Enable Hardware Flow Offloading (MediaTek PPE + WED)
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'

# Drop invalid conntrack packets
[ -z "$(uci -q get firewall.@defaults[0].drop_invalid)" ] && uci set firewall.@defaults[0].drop_invalid='1'

# Stealth firewall: DROP instead of REJECT for input/forward (only if still at the stock REJECT value)
for opt in input forward; do
	[ "$(uci -q get firewall.@defaults[0].$opt)" = "REJECT" ] && uci set firewall.@defaults[0].$opt='DROP'
done
zidx=0
while uci -q get firewall.@zone[$zidx] >/dev/null; do
	if [ "$(uci -q get firewall.@zone[$zidx].name)" = "wan" ]; then
		for opt in input forward; do
			[ "$(uci -q get firewall.@zone[$zidx].$opt)" = "REJECT" ] && uci set firewall.@zone[$zidx].$opt='DROP'
		done
	fi
	zidx=$((zidx + 1))
done
uci -q commit firewall

# Enable CPU frequency, hardware sensors and thermal graphs (collectd) and track the WAN interface
if [ -f /etc/config/luci_statistics ]; then
	for plugin in cpufreq sensors thermal; do
		[ "$(uci -q get luci_statistics.collectd_$plugin.enable)" = "0" ] && uci set luci_statistics.collectd_$plugin.enable='1'
	done
	[ "$(uci -q get luci_statistics.collectd_interface.Interfaces)" = "br-lan" ] && uci set luci_statistics.collectd_interface.Interfaces='br-lan wan'
	uci -q commit luci_statistics
fi

# Enable Receive Packet Steering (RPS + RFS with 128 flows)
uci set network.globals.packet_steering='1'
uci set network.globals.steering_flows='128'
uci -q commit network

# Enable hardware IRQ balancing across CPU cores
if uci -q get irqbalance.irqbalance >/dev/null; then
	uci set irqbalance.irqbalance.enabled='1'
	uci -q commit irqbalance
fi

# Set ZRAM size and compression algorithm to lz4 (lowest latency for Cortex-A53)
uci set system.@system[0].zram_size_mb='120'
uci set system.@system[0].zram_comp_algo='lz4'

# Configure procd service respawn defaults (infinite retry on crash loop)
if ! uci -q get system.@service[0] >/dev/null; then
	uci add system service >/dev/null
fi
uci set system.@service[0].respawn_threshold='3600'
uci set system.@service[0].respawn_timeout='5'
uci set system.@service[0].respawn_retry='0'
uci -q commit system

# Configure https-dns-proxy integration with dnsmasq
if uci -q get https-dns-proxy.config >/dev/null; then
	uci set https-dns-proxy.config.dnsmasq_config_update='*'
	uci set https-dns-proxy.config.conn_loss_time='30'
	uci -q commit https-dns-proxy
fi

# Remember that the defaults have been applied to this configuration
touch /etc/config/ax3200
uci set ax3200.defaults='defaults'
uci set ax3200.defaults.applied='1'
uci -q commit ax3200

exit 0
